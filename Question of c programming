3. Create a program that declares one variable of each of the fundamental data types (int, float, double, char) and prints their size using sizeof() operator.

#include<stdio.h>
int main(){
	int a;
	printf("enter integer no.");
	scanf("%d",&a);
	float b;
	printf("enter float no.");
	scanf("%f",&b);
	double c;
	printf("enter a decimal(double) no.");
	scanf("%lf",&c);
	getchar();
	char d;
	printf("enter a character");
	scanf("%c",&d);
	printf("int value is%d\n float value is%f\n double value is%.2lf \n char is%c\n",a,b,c,d);
	printf("size of int is %zu \n",sizeof(int));
	printf("size of float is %zu\n",sizeof(float));
	printf("size of double is %zu\n",sizeof(double));
	printf("size of char is%zu",sizeof(char));
	return 0;
}


4. Define variables for storing a user's first name, last name, and age using appropriate naming conventions and then display them.

#include <stdio.h>

int main() {
    char f_name[30];
    char l_name[30];
    int age;

    printf("Enter a first name: ");
    scanf("%s", f_name);

    printf("Enter a last name: ");
    scanf(" %s", l_name); // Note the leading space to clear previous whitespaces

    printf("Enter age: ");
    scanf(" %d", &age);   // Note the leading space to skip newlines

    printf("\nFirst name is: %s\nLast name is: %s\nAge is: %d\n", f_name, l_name, age);

    return 0;
}


